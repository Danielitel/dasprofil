---
layout: null
---

<?xml version="1.0" encoding="UTF-8"?>

<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">

  <url>
    <loc>{{ site.url }}{{ site.baseurl }}/</loc>
  </url>

  {% for post in site.posts %}
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}{{ post.url | remove_first: site.baseurl }}</loc>
    <lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
  </url>
  {% endfor %}

  <url>
    <loc>{{ site.url }}{{ site.baseurl }}/about/</loc>
  </url>

  <url>
    <loc>{{ site.url }}{{ site.baseurl }}/news/</loc>
  </url>

  <url>
    <loc>{{ site.url }}{{ site.baseurl }}/biography/</loc>
  </url>

  <url>
    <loc>{{ site.url }}{{ site.baseurl }}/entertainment/</loc>
  </url>

  <url>
    <loc>{{ site.url }}{{ site.baseurl }}/lifestyle/</loc>
  </url>

  <url>
    <loc>{{ site.url }}{{ site.baseurl }}/trending/</loc>
  </url>

</urlset>
